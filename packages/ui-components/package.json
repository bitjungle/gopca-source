{
  "name": "@gopca/ui-components",
  "version": "0.1.0",
  "description": "Shared UI components for GoPCA and GoCSV applications",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.esjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix"
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "dependencies": {
    "@types/plotly.js": "^3.0.10",
    "katex": "^0.16.0",
    "lucide-react": "^0.539.0",
    "plotly.js": "^3.1.0",
    "react-markdown": "^10.1.0",
    "react-plotly.js": "^2.6.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.0.17",
    "@types/react-dom": "^18.0.6",
    "@types/react-plotly.js": "^2.6.3",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.2",
    "vite": "^7.3.3",
    "vite-plugin-dts": "^5.0.0",
    "vitest": "^4.1.11"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.esjs",
      "require": "./dist/index.js"
    },
    "./dist/ui-components.css": "./dist/ui-components.css"
  }
}
