# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env

# Editor/IDE
.vscode/

# Local documentation
docs_tmp/
# Reference materials are local-only (PDFs, summaries, notes)
docs/references/

# Internal development guides are local-only. Kept on disk, never tracked:
# these are working notes for the maintainers, not published documentation.
docs/devel/

# Working notes that accompany a test dataset but are not for publication.
# The datasets themselves are tracked; these are the analyst's scratch documents.
testdata/*/pre_analysis.md

# macOS finder metadata. Covered by most developers' global gitignore, but not
# by everyone's, and a stray .DS_Store in a published dataset folder is noise.
.DS_Store

# Build artifacts
results/

# Only ignore the binary outputs, not build configuration
cmd/gopca-desktop/build/bin/
cmd/gocsv/build/bin/

# Legacy build directory if it exists elsewhere
build/
cmd/gocsv/gocsv
cmd/gopca-desktop/gopca-desktop

# Node modules
node_modules/

# Wails writes this next to package.json to decide whether to re-run npm
# install, and rewrites it whenever it drifts. Tracking it gives every
# developer a permanently dirty working tree (#815).
package.json.md5

# Python
__pycache__/
.venv/

# Temporary images
*.tmp.png

# Certificate files (never commit!)
.certs/
*.p12
*.pfx

# MSIX packaging artifacts
cmd/gopca-desktop/AppxManifest.xml
*.msix
*.appx

# Misc. temp files
_tmp/
testdata/wine/plotly/
testdata/validation/reference_results

# Private PCA presentation (personal, not shared)
testdata/nhanes/pca_presentation/

# Output of scripts/generate-help-docs.js. Regenerated from help-content.json
# on demand; nothing reads it back, so committing it would only create a second
# copy to drift.
docs/generated/

# testdata/Paprika: the source documents and the workbook built from them are
# published under CC BY-NC-ND 4.0, whose ND clause makes redistributing a
# restructured compilation of them doubtful. testdata/Paprika/make_dataset.py
# rebuilds the workbook from documents obtained directly from the publisher.
testdata/Paprika/*.docx
testdata/Paprika/*.xlsx

# Local manual-test plans. These are working documents: they record in-progress
# testing, are rewritten constantly, and are deliberately never tracked. Ignored
# rather than merely untracked because `git add -A testdata/` would otherwise
# sweep them in, which is exactly how they were committed once by accident.
testdata/**/test_plan.md

# Generated by testdata/tecator/make_dataset.py --pcs-out. Reproducible from the
# source file at any time, so committing it would only create a second copy.
testdata/tecator/tecator_supplied_pcs.csv
